{
  "$schema": "../../SmartFilling.Engine/Schema/script-v2.json",

  "version": 2,
  "scriptId": "gt-30-loop-element-then-loopsource",
  "name": "GT30 loopElement 提取(array) -> loopSource 引用 vars 循环处理",
  "description": "phase1 loopElement array 模式提取标量数组到 vars[tableData] / phase2 loopSource=tableData 经 vars fallback 循环（功能1+功能2 互补，array+table 两种模式覆盖）",
  "fields": [],
  "initialVars": [],
  "phases": [
    {
      "kind": "phase",
      "name": "extract-table",
      "type": "loop",
      "loopElement": { "selector": "#data-table tbody tr", "storeAs": "tableData", "storeStructure": "array" },
      "rowIndexOffset": 1,
      "aiGoal": "逐行提取表格 code 到 tableData 标量数组（array 模式，唯一 step.storeAs 来源）",
      "steps": [
        { "kind": "step", "name": "extract-code", "action": "extract", "selector": "#data-table tbody tr:nth-child({{_rowIndex}}) td:nth-child(1)", "storeAs": "code", "property": "textContent" }
      ]
    },
    {
      "kind": "phase",
      "name": "process-rows",
      "type": "loop",
      "loopSource": "tableData",
      "aiGoal": "用 loopSource 引用 tableData（vars fallback）逐行 check _rowItem 在页面中存在",
      "steps": [
        { "kind": "step", "name": "check-rowitem", "action": "check", "detect": { "type": "page_contains", "keywords": ["{{_rowItem}}"] }, "then": "nothing" }
      ]
    }
  ],
  "returnData": {
    "extractedTags": "{{tableData}}"
  }
}
