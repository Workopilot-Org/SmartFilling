{
  "WorkerOptions": {
    "MaxConcurrentTasks": 1,
    "CorsOrigins": ["*"],
    "IgnoreNullFieldsOnScriptValidation": true,
    "AttachmentDownloadTimeoutSeconds": 60,
    "TaskResultStore": {
      "FilePath": "data/task-results.jsonl",
      "RetentionDays": 7,
      "CleanupIntervalHours": 6
    },
    "ProgressReport": {
      "Enabled": { "Push": true, "Pull": false },
      "Types": { "Log": true, "Screenshot": true, "Completed": false },
      "PushOptions": { "TimeoutSeconds": 5 }
    },
    "CompleteReport": {
      "Enabled": { "Push": true, "Pull": false },
      "PushOptions": {
        "TimeoutSeconds": 10,
        "Retry": { "Count": 3, "Interval": 1000 }
      }
    }
  },
  "AiProvider": {
    "ApiKey": "",
    "ModelId": "deepseek-v4-flash-0731",
    "Endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "ModelApiErrorOptions": {
      "MaxRetryCount": 2,
      "RetryBaseInterval": 1000,
      "CircuitBreakerThreshold": 5
    }
  },
  "ScriptEngine": {
    "Headless": false,
    "SlowMo": 0,
    "StepIntervalMs": 500,
    "Viewport": {
      "Width": 1280,
      "Height": 720
    },
    "BrowserPath": null,
    "DefaultTimeout": 30000,
    "MaxScriptDuration": 600000,
    "StepRetry": {
      "Count": 1,
      "Interval": 1000
    },
    "OnError": "stop",
    "MaxAiTurns": 30,
    "DefaultAiTimeout": 180000,
    "WaitCheckInterval": 2000,
    "MaxLoopCount": 100,
    "MaxPhaseGotoCount": 20,
    "MaxPhaseJumpCount": 10,
    "Screenshot": {
      "OnPhaseProgress": false,
      "OnStepFailure": false,
      "OnTaskComplete": true,
      "OnTaskFailure": true,
      "CompressQuality": 70,
      "ActionDefaultFolder": "screenshots/",
      "OnStepFailureFolder": "logs/"
    },
    "Compression": {
      "Threshold": 30,
      "MinimumPreserved": 5,
      "PreserveInitialUserMessages": true
    },
    "Rerun": {
      "MaxRowRerunCount": 2,
      "MaxPhaseRerunCount": 2,
      "Interval": 1000
    },
    "UploadRootPath": ""
  },
  "CaptchaService": {
    "Url": "http://localhost:8000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
